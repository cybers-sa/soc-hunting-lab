#!/usr/bin/env bash
# Start the SOC dashboard on port 8000 (runs in the background).
LAB="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if curl -fs -o /dev/null http://localhost:8000/api/cases; then
  echo "SOC Dashboard is running on port 8000"
  exit 0
fi
nohup setsid python3 "$LAB/dashboard/server.py" >/tmp/soc-dashboard.log 2>&1 < /dev/null &
for _ in $(seq 1 20); do
  curl -fs -o /dev/null http://localhost:8000/api/cases && break
  sleep 0.5
done
echo "SOC Dashboard is running on port 8000"
