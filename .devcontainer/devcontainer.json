{
  "name": "SOC Hunting Lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash setup.sh",
  "postAttachCommand": "bash bin/dashboard && cat bin/welcome.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "mechatroner.rainbow-csv"
      ]
    }
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "SOC Dashboard",
      "onAutoForward": "openBrowser"
    }
  }
}
